rules_version = '2';

// Koleksiyonlar:
//   cafes/{uid}                  — mekan profili (doc id = mekan sahibinin Auth uid'i)
//   cafes/{uid}/photos/{id}      — mekan fotoğrafları (herkes görür)
//   broadcasts/{uid}_{matchId}   — mekanın vereceği maç
//   reservations/{auto}          — taraftar rezervasyonu
//   codes/{KOD}                  — tek seferlik aktivasyon kodları
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(cafeId) { return signedIn() && request.auth.uid == cafeId; }
    // Yönetim sayfası: sadece bu Google hesabı
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'kagankarki03@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function codePath(code) { return /databases/$(database)/documents/codes/$(code); }

    match /cafes/{cafeId} {
      allow read: if true;

      function data() { return request.resource.data; }
      function coverOk() {
        return !('cover' in data()) || data().cover == null || (data().cover is string && data().cover.size() < 150000);
      }
      function basicsOk() {
        return data().plan in ['standart', 'pro']
          && data().membership.keys().hasOnly(['status', 'startedAt', 'renewsAt'])
          && data().membership.status == 'trial'
          && data().membership.startedAt is timestamp
          && data().membership.renewsAt is timestamp
          && data().membership.startedAt < request.time + duration.value(1, 'h')
          && data().name is string && data().name.size() <= 80
          && data().capacity is int && data().capacity > 0 && data().capacity <= 5000
          && data().phone is string && data().phone.size() <= 15
          && coverOk();
      }
      // Normal kayıt: en fazla 14 günlük deneme
      function trialOk() {
        return !('activationCode' in data())
          && data().membership.renewsAt < request.time + duration.value(15, 'd');
      }
      // Kodlu kayıt: kod kullanılmamış olmalı ve aynı işlemde bu mekana yazılmalı; süre ve plan koddan gelir
      function codeOk() {
        let code = data().activationCode;
        let c = get(codePath(code)).data;
        return code is string
          && c.used == false
          && getAfter(codePath(code)).data.usedBy == request.auth.uid
          && data().plan == c.plan
          && data().membership.renewsAt < request.time + duration.value(c.days + 1, 'd');
      }

      // Mekan kendisi kayıt olur ya da yönetici mekan adına hesap açar
      allow create: if isAdmin() || (isOwner(cafeId) && basicsOk() && (trialOk() || ('activationCode' in data() && codeOk())));

      // Mekan kendi bilgisini (kapak dahil) günceller; üyelik, plan ve koda dokunamaz.
      // Üyeliği ödeme altyapısı / yönetici değiştirir.
      allow update: if isAdmin() || (isOwner(cafeId)
        && data().membership == resource.data.membership
        && data().plan == resource.data.plan
        && data().get('activationCode', null) == resource.data.get('activationCode', null)
        && coverOk());

      match /photos/{photoId} {
        allow read: if true;
        allow create: if isOwner(cafeId)
          && request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if isOwner(cafeId);
      }
    }

    match /codes/{code} {
      // Tek kod sorgulanabilir (kayıt ekranı kontrolü); liste sadece yöneticiye
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && resource.data.used == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && getAfter(/databases/$(database)/documents/cafes/$(request.auth.uid)).data.activationCode == code);
    }

    match /broadcasts/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.cafeId == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.matchId
        && request.resource.data.reserved == 0;
      allow delete: if signedIn() && resource.data.cafeId == request.auth.uid;

      function resPath(rid) { return /databases/$(database)/documents/reservations/$(rid); }
      function nextData() { return request.resource.data; }
      // Yeni rezervasyon: aynı işlemde oluşan rezervasyonun kişi sayısı kadar artar, kapasiteyi aşamaz
      function bookingOk() {
        let rid = nextData().lastRes;
        let r = getAfter(resPath(rid)).data;
        return !exists(resPath(rid))
          && r.userId == request.auth.uid
          && r.cafeId == resource.data.cafeId && r.matchId == resource.data.matchId
          && nextData().reserved == resource.data.reserved + r.people
          && nextData().reserved <= resource.data.seats;
      }
      // İptal: aynı işlemde müşterinin kendi rezervasyonu iptal edilir, kişi sayısı kadar azalır
      function cancelOk() {
        let rid = nextData().lastRes;
        let before = get(resPath(rid)).data;
        return before.userId == request.auth.uid
          && before.cafeId == resource.data.cafeId && before.matchId == resource.data.matchId
          && before.status == 'new' && getAfter(resPath(rid)).data.status == 'cancelled'
          && nextData().reserved == resource.data.reserved - before.people;
      }

      allow update: if
        // mekan sahibi her şeyi düzenleyebilir
        (signedIn() && resource.data.cafeId == request.auth.uid)
        // taraftar: sayaç sadece gerçek bir rezervasyon ya da iptalle birlikte değişebilir
        || (signedIn()
            && nextData().diff(resource.data).affectedKeys().hasOnly(['reserved', 'lastRes'])
            && (bookingOk() || cancelOk()));
    }

    // Üyelik ödemeleri: sadece sunucu (iyzico dönüşü, Admin SDK) yazar; mekan kendi ödemelerini, yönetici hepsini görür
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.cafeId == request.auth.uid);
      allow write: if false;
    }

    // Taraftar profili: ad + telefon (rezervasyon için zorunlu)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 15;
    }

    match /reservations/{id} {
      function d() { return request.resource.data; }
      function bcPath(cafeId, matchId) { return /databases/$(database)/documents/broadcasts/$(cafeId + '_' + matchId); }

      // Giriş yapmış taraftar, maç başlamadan, en fazla 12 kişi; sayaçla aynı işlemde
      allow create: if signedIn()
        && d().userId == request.auth.uid
        && d().keys().hasOnly(['cafeId', 'matchId', 'userId', 'name', 'phone', 'people', 'code', 'createdAt', 'status', 'kickoff'])
        && d().people is int && d().people >= 1 && d().people <= 12
        && d().name is string && d().name.size() >= 2 && d().name.size() <= 60
        && d().phone is string && d().phone.size() >= 10 && d().phone.size() <= 20
        && d().status == 'new'
        && d().kickoff is timestamp && request.time < d().kickoff
        && get(bcPath(d().cafeId, d().matchId)).data.get('kickoff', d().kickoff) == d().kickoff
        && getAfter(bcPath(d().cafeId, d().matchId)).data.lastRes == id;

      // Telefon numaraları sadece ilgili mekana, rezervasyonu yapan taraftara ve yöneticiye görünür
      allow read: if isAdmin() || (signedIn() && (resource.data.cafeId == request.auth.uid || resource.data.get('userId', '') == request.auth.uid));

      allow update: if signedIn() && (
        // mekan: geldi / gelmedi / geri al
        (resource.data.cafeId == request.auth.uid
          && d().diff(resource.data).affectedKeys().hasOnly(['status'])
          && d().status in ['new', 'arrived', 'noshow'])
        // taraftar: iptal, sadece maça 1 saat kalana kadar; boşalan yer aynı işlemde sayaca döner
        || (resource.data.get('userId', '') == request.auth.uid
          && resource.data.status == 'new'
          && d().status == 'cancelled'
          && d().diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && request.time < resource.data.kickoff - duration.value(1, 'h')
          && getAfter(bcPath(resource.data.cafeId, resource.data.matchId)).data.lastRes == id)
      );
    }
  }
}
