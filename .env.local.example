# Bu dosyayı .env.local olarak kopyala ve doldur. .env / .env.local depoya GİRMEZ.
# Canlıda (Vercel) aynı değişkenler: Project → Settings → Environment Variables (Production).
# NEXT_PUBLIC_FIREBASE_* olmadan canlı derleme bilerek durur (next.config.mjs); site demo moduna düşmez.

# ---- Firebase web ayarları (Firebase Console → Proje ayarları → Genel → Web uygulaması) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Ödeme: iyzico ----
# Test için ücretsiz hesap: https://sandbox-merchant.iyzipay.com → Ayarlar → Firma ayarları → API anahtarları
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com  ·  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# İsteğe bağlı: alıcı TC kimlik no varsayılanı (iyzico zorunlu alan)
IYZICO_DEFAULT_IDENTITY=

# ---- Sunucu tarafı Firebase (ödeme sonrası üyeliği uzatmak için) ----
# Firebase Console → Proje ayarları → Hizmet hesapları → "Yeni özel anahtar oluştur" → indirilen JSON'un tamamı tek satır
# (ya da base64'ü). Bu anahtar tam yetkilidir: kimseyle paylaşma, depoya koyma.
FIREBASE_SERVICE_ACCOUNT=

# ---- Google Maps (isteğe bağlı) ----
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
